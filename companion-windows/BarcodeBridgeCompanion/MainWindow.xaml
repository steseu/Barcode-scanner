<Window x:Class="BarcodeBridgeCompanion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BarcodeBridge Companion" Height="560" Width="420"
        WindowStartupLocation="CenterScreen"
        Topmost="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="BarcodeBridge Companion" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>

        <Image Grid.Row="1" x:Name="QrImage" Width="220" Height="220" HorizontalAlignment="Center" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="2" x:Name="ConnectionInfoText" TextWrapping="Wrap" Margin="0,0,0,4"
                   Text="Host: - Port: - Token: -"/>

        <TextBlock Grid.Row="3" x:Name="StatusText" FontWeight="SemiBold" Margin="0,0,0,12" Text="Starting..."/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,12">
            <CheckBox x:Name="SendEnterCheckBox" Content="Send Enter after each scan" IsChecked="True" Margin="0,0,16,0"/>
            <Button x:Name="RegenerateTokenButton" Content="New pairing code" Click="RegenerateTokenButton_Click"/>
        </StackPanel>

        <GroupBox Grid.Row="5" Header="Received scans">
            <ListBox x:Name="ScanLogListBox"/>
        </GroupBox>
    </Grid>
</Window>
